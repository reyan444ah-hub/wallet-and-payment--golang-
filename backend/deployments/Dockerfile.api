
# Build stage
FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN mkdir -p /out && \
    CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/api ./cmd/api-service

# Runtime stage
FROM alpine:3.22

RUN apk add --no-cache ca-certificates && \
    addgroup -S app && \
    adduser -S -G app app

WORKDIR /app

COPY --from=builder --chown=app:app /out/api ./api
COPY --from=builder --chown=app:app /src/migrations ./migrations

ENV PORT=8080
ENV MIGRATION_PATH=migrations/000001_init_schema.sql

EXPOSE 8080

USER app

ENTRYPOINT ["./api"]
