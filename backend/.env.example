# Copy to .env and replace every placeholder before starting the stack.

PORT=8080
GRPC_PORT=50051

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_unique_random_database_password
POSTGRES_DB=wallet_ledger
DB_HOST=localhost
DB_PORT=5432
MIGRATION_PATH=migrations/000001_init_schema.sql

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=replace_with_a_unique_random_redis_password

# NATS JetStream
NATS_URL=nats://localhost:4222

# Risk Service RPC Address
RISK_SERVICE_ADDR=localhost:50051

# Authentication secret: use at least 32 cryptographically random bytes.
JWT_SECRET=replace_with_at_least_32_random_bytes
WEBHOOK_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
