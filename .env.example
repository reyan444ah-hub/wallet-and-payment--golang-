# Environment Variables for Distributed Wallet & Payment Platform

PORT=8080
GRPC_PORT=50051

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=wallet_ledger
DB_HOST=localhost
DB_PORT=5432
MIGRATION_PATH=migrations/000001_init_schema.sql

# Redis
REDIS_ADDR=localhost:6379

# NATS JetStream
NATS_URL=nats://localhost:4222

# Risk Service RPC Address
RISK_SERVICE_ADDR=localhost:50051

# Authentication Security Secrets (REQUIRED: generate a high-entropy string in production)
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
