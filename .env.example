# Environment Variables for Distributed Wallet & Payment Platform

PORT=8080
GRPC_PORT=50051

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=wallet_ledger
MIGRATION_PATH=migrations/000001_init_schema.sql

# Redis
REDIS_ADDR=localhost:6379

# NATS JetStream
NATS_URL=nats://localhost:4222

# Risk Service RPC Address
RISK_SERVICE_ADDR=localhost:50051

# Authentication Security Secrets
JWT_SECRET=super-secret-jwt-signing-key-change-in-production-123456
